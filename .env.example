# Copiar a %APPDATA%\Zero\.env  (sin secretos: las claves nunca van aqui)
# true = modo seguro: no envia nada. En produccion se instala con false.
DRY_RUN=true
DEFAULT_TIMEOUT_MS=30000
LOG_RETENTION_DAYS=30
PAUSA_ENTRE_S=30
SRI_LOGIN_URL=https://srienlinea.sri.gob.ec/sri-en-linea/SriDeclaraciones/Publico/declaraciones

# Archivos de trabajo (ruta local mientras no haya Graph). Usar barras / y sin comillas.
CONTROL_XLSX=
CREDENCIALES_XLSX=

#Evidencias
ZERO_DOCS=

# Microsoft Graph (opcional): cliente confidencial con permiso de aplicacion.
# Con GRAPH_CONTROL_* el Control se lee y se anota en OneDrive/SharePoint en vez de usar CONTROL_XLSX; con
# GRAPH_CREDENCIALES_* el archivo cifrado se descarga a memoria en vez de usar CREDENCIALES_XLSX.
# Los IDs de archivo: py -m diagnostics.diag_graph --buscar CUENTA RUTA --como control --escribir
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
# El secreto NO va aqui: se guarda en el Administrador de credenciales de Windows y aqui solo va su nombre.
# El instalador lo guarda con: cmdkey /generic:Zero.MicrosoftSecret /user:zero /pass:<secreto>
MICROSOFT_SECRET_TARGET=Zero.MicrosoftSecret
# Ultimo recurso (texto plano, no recomendado): MICROSOFT_CLIENT_SECRET=
GRAPH_CONTROL_DRIVE_ID=
GRAPH_CONTROL_ITEM_ID=
GRAPH_CREDENCIALES_DRIVE_ID=
GRAPH_CREDENCIALES_ITEM_ID=